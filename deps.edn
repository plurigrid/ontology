{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        com.rpl/specter {:mvn/version "1.1.4"}}
 :aliases
 {:run {:main-opts ["-m" "plurigrid.ontology.history"]}
  :test {:extra-paths ["test"]
         :main-opts ["-m" "plurigrid.ontology.test-runner"]}
  :cider {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                       cider/cider-nrepl {:mvn/version "0.62.2"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"]}}}
